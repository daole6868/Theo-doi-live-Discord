# ============================================
#  DISCORD BOT — CẤU HÌNH BÍ MẬT
#  Copy file này thành `.env` rồi điền giá trị.
#  KHÔNG BAO GIỜ commit file `.env` lên git.
# ============================================

# Bot token — lấy từ Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# ID Server (Guild)
GUILD_ID=1235074618180636772

# ID Danh mục chứa các kênh voice CTV
TARGET_CATEGORY_ID=1235075173498097686

# ID Kênh Admin (nơi post dashboard admin, chạy lệnh setup)
ADMIN_CHANNEL_ID=1459437445333385277

# ID Role quản lý được dùng Admin Dashboard (ngoài người có quyền Administrator).
# Để 0 nếu chỉ cho Administrator dùng.
ADMIN_ROLE_ID=0

# ID Kênh Khách (nơi post dropdown chọn kênh theo dõi)
USER_CHANNEL_ID=1459437426136186880

# ID Kênh gửi BXH mỗi ngày lúc 00:05
LEADERBOARD_CHANNEL_ID=1429388907023437934

# ID Kênh Bot báo cáo khi CTV đi trễ (quá 30 phút)
LATE_ALERT_CHANNEL_ID=1474048003219128511

# ID Kênh check thời gian live của CTV (feature mới - dashboard UI)
CHECK_CTV_CHANNEL_ID=0
